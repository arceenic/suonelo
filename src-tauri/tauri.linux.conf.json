{
  "build": {
    "beforeBuildCommand": "npm run build -- --webpack"
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Music",
    "shortDescription": "Browse Qobuz and save music to your computer",
    "icon": ["icons/suonelo-32.png", "icons/suonelo-128.png", "icons/suonelo-256.png"],
    "linux": {
      "deb": {
        "depends": ["libc6 (>= 2.34)", "libdbus-1-3"],
        "recommends": ["gnome-keyring"],
        "section": "sound",
        "changelog": "../docs/CHANGELOG.md",
        "files": {
          "/usr/share/doc/suonelo/ASSET-NOTICES.md": "../ASSET-NOTICES.md",
          "/usr/share/doc/suonelo/copyright": "../LICENSE",
          "/usr/share/doc/suonelo/licenses": "../licenses"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/doc/suonelo/ASSET-NOTICES.md": "../ASSET-NOTICES.md",
          "/usr/share/doc/suonelo/CHANGELOG.md": "../docs/CHANGELOG.md",
          "/usr/share/doc/suonelo/copyright": "../LICENSE",
          "/usr/share/doc/suonelo/licenses": "../licenses"
        }
      }
    }
  }
}
